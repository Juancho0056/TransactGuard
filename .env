# QA environment configuration for docker compose
ANTIFRAUD_DB_NAME=antifraud_service
ANTIFRAUD_DB_PORT=5432
ANTIFRAUD_DB_USER=postgres
ANTIFRAUD_DB_PASSWORD=postgres

TRANSACTION_DB_NAME=transaction_service
TRANSACTION_DB_PORT=5433
TRANSACTION_DB_USER=postgres
TRANSACTION_DB_PASSWORD=postgres

KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_JMX_PORT=9991

ANTIFRAUD_SERVICE_PORT=8081
ANTIFRAUD_SERVICE_ENV_FILE=AntiFraudService/.env

TRANSACTION_SERVICE_PORT=8082
TRANSACTION_SERVICE_ENV_FILE=TransactionService/.env
ANTIFRAUD_SERVICE_ENVIRONMENT=Development
TRANSACTION_SERVICE_ENVIRONMENT=Development
TRANSACTION_FRAUD_WORKER_ENVIRONMENT=Production
TRANSACTION_OUTBOX_WORKER_ENVIRONMENT=Production