{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "Topic": "transactions.created",
    "GroupId": "transaction-fraud-worker",
    "EnsureTopicExists": true,
    "TopicCreationMaxAttempts": 0,
    "TopicCreationBackoffMs": 2000,
    "NumPartitions": 1,
    "ReplicationFactor": 1
  },
  "AntiFraudApi": {
    "BaseAddress": "http://antifraud-service:8080"
  },
  "TransactionServiceApi": {
    "BaseAddress": "http://transaction-service:8080"
  },
  "Processing": {
    "MaxRetries": 5,
    "InitialBackoffSeconds": 2,
    "MaxBackoffSeconds": 30,
    "EnableJitter": true,
    "JitterSeconds": 0.75
  },
  "KafkaDlq": {
    "BootstrapServers": "kafka:29092",
    "Topic": "transactions.created.dlq",
    "Acks": "All"
  }
}
