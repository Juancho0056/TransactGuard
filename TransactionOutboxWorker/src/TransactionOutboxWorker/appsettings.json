{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ClientId": "transaction-outbox-worker"
  },
  "TimeZone": {
    "TimeZoneId": "America/Bogota"
  },
  "ConnectionStrings": {
    "TransactionServiceDb": "Host=transaction-db;Port=5433;Database=transaction_service;Username=postgres;Password=postgres"
  },
  "Processing": {
    "BatchSize": 50,
    "PollingIntervalSeconds": 5
  }
}
